    "mod_info-choose_SE_ui": {
      "html": "<div id=\"mod_info-selectInputSE\" class=\"form-group shiny-input-radiogroup shiny-input-container\" role=\"radiogroup\" aria-labelledby=\"mod_info-selectInputSE-label\">\n  <label class=\"control-label\" id=\"mod_info-selectInputSE-label\" for=\"mod_info-selectInputSE\">Select an assay for further information<\/label>\n  <div class=\"shiny-options-group\">\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"mod_info-selectInputSE\" value=\"Convert\" checked=\"checked\"/>\n        <span>Convert<\/span>\n      <\/label>\n    <\/div>\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"mod_info-selectInputSE\" value=\"DataGeneration\"/>\n        <span>DataGeneration<\/span>\n      <\/label>\n    <\/div>\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"mod_info-selectInputSE\" value=\"Preprocessing\"/>\n        <span>Preprocessing<\/span>\n      <\/label>\n    <\/div>\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"mod_info-selectInputSE\" value=\"Clustering\"/>\n        <span>Clustering<\/span>\n      <\/label>\n    <\/div>\n  <\/div>\n<\/div>",
