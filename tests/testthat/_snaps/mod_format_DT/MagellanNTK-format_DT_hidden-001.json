          "rowCallback": "function(row, data, displayNum, displayIndex, dataIndex) {\nvar value=data[5]; $(this.api().cell(row, 0).node()).css({'background-color':value == \"A\" ? \"#1B9E77\" : value == \"B\" ? \"#D95F02\" : value == \"C\" ? \"#7570B3\" : value == \"D\" ? \"#E7298A\" : value == \"E\" ? \"#66A61E\" : null});\nvar value=data[6]; $(this.api().cell(row, 1).node()).css({'background-color':value == \"A\" ? \"#1B9E77\" : value == \"B\" ? \"#D95F02\" : value == \"C\" ? \"#7570B3\" : value == \"D\" ? \"#E7298A\" : value == \"E\" ? \"#66A61E\" : null});\nvar value=data[7]; $(this.api().cell(row, 2).node()).css({'background-color':value == \"A\" ? \"#1B9E77\" : value == \"B\" ? \"#D95F02\" : value == \"C\" ? \"#7570B3\" : value == \"D\" ? \"#E7298A\" : value == \"E\" ? \"#66A61E\" : null});\nvar value=data[8]; $(this.api().cell(row, 3).node()).css({'background-color':value == \"A\" ? \"#1B9E77\" : value == \"B\" ? \"#D95F02\" : value == \"C\" ? \"#7570B3\" : value == \"D\" ? \"#E7298A\" : value == \"E\" ? \"#66A61E\" : null});\nvar value=data[9]; $(this.api().cell(row, 4).node()).css({'background-color':value == \"A\" ? \"#1B9E77\" : value == \"B\" ? \"#D95F02\" : value == \"C\" ? \"#7570B3\" : value == \"D\" ? \"#E7298A\" : value == \"E\" ? \"#66A61E\" : null});\n}",
